---
import SectionHeading from "../components/SectionHeading.astro";
import Layout from "../layouts/Layout.astro";
import { profile, social } from "../data/profile";
---

<Layout>
  <main class="flex flex-col gap-7 py-[clamp(56px,9vw,120px)]">
    <p class="text-sm text-muted">$ whoami</p>
    <h1
      class="text-[clamp(44px,7vw,96px)] leading-none font-bold tracking-[-0.03em] text-fg-strong"
    >
      {profile.name}
    </h1>
    <p
      class="max-w-[680px] font-sans text-[clamp(18px,1.8vw,24px)] leading-normal text-prose-muted"
    >
      {profile.title}.
    </p>
    <section aria-labelledby="status-h" class="flex flex-col gap-6 pt-12">
      <SectionHeading id="status-h">status</SectionHeading>
      <p class="max-w-[760px] font-sans text-[19px] leading-[1.65] text-prose">
        The new site is being rebuilt. Meanwhile, find me on <a href={social.github}>GitHub</a> or <a href={social.linkedin}>LinkedIn</a>.
      </p>
    </section>
  </main>
</Layout>
