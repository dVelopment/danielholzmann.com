---
/**
 * Head styles for the focus areas section's two-way highlight, without JavaScript: hovering a list item or giving
 * it keyboard focus (`:focus-visible`, so a mouse click doesn't leave it lit), or hovering a radar label,
 * highlights every element of that focus area. Elements share a focus area through `data-focus-area="<index>"`
 * (see FocusAreas.astro): the list item, its radar label (`text`), spoke (`line`) and vertex dot (`circle`); the
 * list item's `data-level` and `data-experience` spans swap. Needs `:has()`; the list item's own
 * hover/`:focus-visible` reveal is styled in FocusAreas.astro so it works without it.
 */
import { radarAxes } from "../data/focus-areas";

const active = radarAxes
  .map(
    (_, i) =>
      `#focus-areas:has(:is(li,text)[data-focus-area="${i}"]:is(:hover,:focus-visible)) [data-focus-area="${i}"]`,
  )
  .join(",");
const css = [
  `text:is(${active}){fill:var(--color-accent)}`,
  `line:is(${active}){stroke:var(--color-accent)}`,
  `circle:is(${active}){opacity:1}`,
  `li:is(${active}) [data-level]{opacity:0}`,
  `li:is(${active}) [data-experience]{opacity:1}`,
].join("");
---

<style is:inline set:html={css} />
