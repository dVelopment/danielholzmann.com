---
/** Section heading as a terminal prompt (`## ` by default) followed by the slot. */
interface Props {
  id?: string;
  /** Text before the slot; defaults to `## `, e.g. `$ ` for a shell command heading. */
  prompt?: string;
}

const { id, prompt = "## " } = Astro.props;
---

<h2
  id={id}
  class="text-sm font-medium text-accent print:font-mono print:text-xs print:font-bold print:text-print-accent"
>
  {prompt}<slot />
</h2>
