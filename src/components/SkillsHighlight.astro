---
/**
 * Head styles for the skills section's two-way highlight, without JavaScript: hovering a list item or giving it
 * keyboard focus (`:focus-visible`, so a mouse click doesn't leave it lit), or hovering a radar label,
 * highlights every element of that skill. Elements share a skill through `data-skill="<index>"` (see
 * Skills.astro): the list item, its radar label (`text`), spoke (`line`) and vertex dot (`circle`); the list
 * item's `data-capped` and `data-detail` spans swap. Needs `:has()`; the list item's own hover/`:focus-visible`
 * reveal is styled in Skills.astro so it works without it.
 */
import { skills } from "../data/skills";

const active = skills
  .map((_, i) => `#skills:has(:is(li,text)[data-skill="${i}"]:is(:hover,:focus-visible)) [data-skill="${i}"]`)
  .join(",");
const css = [
  `text:is(${active}){fill:var(--color-accent)}`,
  `line:is(${active}){stroke:var(--color-accent)}`,
  `circle:is(${active}){opacity:1}`,
  `li:is(${active}) [data-capped]{opacity:0}`,
  `li:is(${active}) [data-detail]{opacity:1}`,
].join("");
---

<style is:inline set:html={css} />
