---
/**
 * Print-only contact block of the CV; the screen has its own (Contact.astro).
 * Icons on a 24×24 grid: the GitHub mark is Simple Icons 16.36.0 (CC0); the rest are drawn for this site,
 * LinkedIn included because Simple Icons dropped it.
 */
import { bareUrl, profile, social } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";

interface Icon {
  /** Outlined glyphs are stroked like the print button's icon; brand marks are filled. */
  style: "stroke" | "fill";
  d: string;
}

const icons = {
  location: { style: "stroke", d: "M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zM9.5 9.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0" },
  mail: { style: "stroke", d: "M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM3 7l9 6 9-6" },
  phone: { style: "stroke", d: "M5 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z" },
  site: { style: "stroke", d: "M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M3 12h18M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z" },
  linkedin: {
    style: "fill",
    d: "M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM5.5 9.5h3v9h-3zM5.4 6.5a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0zM10.5 9.5h2.8v1.2c.5-.9 1.6-1.4 2.8-1.4 2.3 0 3.4 1.4 3.4 4v5.2h-2.9v-4.7c0-1.2-.4-2-1.5-2s-1.8.8-1.8 2v4.7h-2.8z",
  },
  github: {
    style: "fill",
    d: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
} satisfies Record<string, Icon>;

const rows: { icon: Icon; text: string; href?: string }[] = [
  { icon: icons.location, text: profile.location },
  { icon: icons.mail, text: profile.email, href: `mailto:${profile.email}` },
  { icon: icons.phone, text: profile.phone, href: `tel:${profile.phone.replace(/[^+\d]/g, "")}` },
  ...(["site", "linkedin", "github"] as const).map((name) => {
    const href = name === "site" ? profile.siteUrl : social[name];
    return { icon: icons[name], text: bareUrl(href), href };
  }),
];
---

<section id="cv-contact" class="hidden flex-col gap-2 print:flex">
  <SectionHeading>contact</SectionHeading>
  {
    rows.map(({ icon, text, href }) => (
      <p class="flex gap-2">
        {/* One line tall, so the 12px glyph centres on the first line when a link wraps. */}
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class:list={[
            "h-lh w-3 flex-none text-ink-muted",
            icon.style === "fill" ? "fill-current" : "fill-none stroke-current",
          ]}
          fill-rule={icon.style === "fill" ? "evenodd" : undefined}
          stroke-width={icon.style === "stroke" ? 2 : undefined}
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d={icon.d} />
        </svg>
        {href ? <a href={href}>{text}</a> : text}
      </p>
    ))
  }
</section>
