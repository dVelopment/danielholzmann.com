---
/**
 * Print-only contact block of the CV; the screen has its own (Contact.astro).
 * Icons on a 24×24 grid: the GitHub and Mastodon marks are Simple Icons 16.36.0 (CC0); the rest are drawn
 * for this site, LinkedIn included because Simple Icons dropped it.
 */
import { bareUrl, profile, social } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";

interface Icon {
  /** Outlined glyphs are stroked like the print button's icon; brand marks are filled. */
  style: "stroke" | "fill";
  d: string;
}

